// Copy this file to Secrets.xcconfig and fill in the values.
// The `$()` in the URLs is required: without it `//` would start an xcconfig comment.
API_BASE_URL = https:$()//foufou.jp
WEB_BASE_URL = https:$()//foufou.jp
FIREBASE_API_KEY = your-firebase-web-api-key
FIREBASE_STORAGE_BUCKET = your-project.firebasestorage.app
// iOS OAuth client ID from Firebase console (add iOS app) or GCP > Credentials. Leave empty to hide the Google button.
GOOGLE_IOS_CLIENT_ID = 
