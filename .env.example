SUPABASE_SERVICE_ROLE_KEY=

# Token encryption (32 bytes base64)
TOKEN_ENCRYPTION_KEY=

# Generator (Cloud Run)
GENERATOR_URL=
GENERATOR_SHARED_SECRET=
