# Google Cloud / OAuth
GCP_PROJECT_ID=tablychat
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_REDIRECT_URI_LOCAL=http://localhost:3000/api/auth/google/callback
OAUTH_REDIRECT_URI_PROD=
